# Salin ke .env lalu isi nilainya. Jangan pernah meng-commit .env.

# --- Inti ---
# Wajib di produksi. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True di laptop, False di produksi
DEBUG=True
# Daftar domain dipisah koma, mis. localhost,127.0.0.1,pcm-banjarsari.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Domain produksi lengkap dengan https://, dipisah koma
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Kosong -> SQLite (db.sqlite3). Isi URL PostgreSQL untuk Supabase/Neon, mis.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Isi True jika memakai connection pooler mode transaction (Supabase port 6543 / Neon "-pooler")
DB_TRANSACTION_POOLER=False

# --- Keamanan (opsional, bawaan sudah aman untuk produksi) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Object storage untuk file unggahan (opsional; kosong -> disimpan di folder media/) ---
# Contoh Supabase Storage (S3-compatible): endpoint https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Domain publik bucket (opsional), mis. <project-ref>.supabase.co/storage/v1/object/public/<bucket>
AWS_S3_CUSTOM_DOMAIN=
